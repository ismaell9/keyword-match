# rag-doc-qa configuration.
# Copy to .env and edit. Every value here is optional; the defaults shown are
# what the service uses when the variable is unset. See docs/architecture.md.

# ------------------------------------------------------------------ storage
# SQLite database file (FTS5 + vec0 live in this single file).
RAGQA_DB_PATH=data/index.sqlite3
# Directory of source documents ingested by `cli.py ingest`.
RAGQA_CORPUS_DIR=data/corpus
# auto -> sqlite-vec if the extension loads, else numpy brute force.
# sqlite -> require vec0 (fail loudly if missing).  numpy -> force fallback.
RAGQA_VECTOR_BACKEND=auto
# Skip files whose sha256 already matches the indexed copy.
RAGQA_INCREMENTAL_INGEST=true

# ---------------------------------------------------------------- chunking
# "Words" = whitespace-separated tokens, a documented dependency-free proxy for
# subword tokens. Tune per corpus; the eval harness is what tells you if it helped.
RAGQA_CHUNK_SIZE_WORDS=220
RAGQA_CHUNK_OVERLAP_WORDS=40
RAGQA_CHUNK_MIN_WORDS=40

# --------------------------------------------------------------- embeddings
# auto -> fastembed if importable and the model loads, else the LABELLED hash stub.
# The stub is for smoke tests only; retrieval quality on it is meaningless.
RAGQA_EMBED_BACKEND=auto
RAGQA_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAGQA_EMBED_DIM=384
RAGQA_EMBED_BATCH_SIZE=32

# ---------------------------------------------------------------- retrieval
RAGQA_BM25_TOP_K=50
RAGQA_VECTOR_TOP_K=50
RAGQA_RRF_K=60
RAGQA_FUSION_TOP_K=50
RAGQA_RETRIEVE_TOP_K=8

# ---------------------------------------------------------------- re-ranking
RAGQA_RERANK_ENABLED=true
RAGQA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAGQA_RERANK_TOP_N=50

# ---------------------------------------------------------------- generation
# Point OPENAI_BASE_URL at any OpenAI-compatible endpoint: local Ollama (default),
# vLLM, llama.cpp server, OpenAI, Azure, Groq, Together...
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600
# Thinking models (Qwen3.5 on Ollama) can spend the whole token budget on their
# reasoning channel and return empty `content`. Set to "none" to disable that.
# Leave unset for non-reasoning endpoints.
LLM_REASONING_EFFORT=none
# Arbitrary extra JSON merged into the chat-completions body, e.g. for vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Minimum cross-encoder evidence confidence in [0,1] required before we even ask
# the LLM. 0 disables the pre-generation gate (the LLM's own abstention still applies).
RAGQA_MIN_EVIDENCE_CONFIDENCE=0.15

# ---------------------------------------------------------------------- api
RAGQA_API_TITLE=rag-doc-qa
RAGQA_MAX_UPLOAD_BYTES=26214400
